# Firebase Web App credentials (NOT GoogleService-Info.plist values).
# The JS SDK requires the Web App config from Firebase Console →
# Project Settings → Your Apps → Web App → SDK setup and configuration.
#
# Copy this file to .env and fill in your values.
EXPO_PUBLIC_FIREBASE_API_KEY=your_web_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=1:your_sender_id:web:your_web_app_id
# Optional release guard. Set this to the production project ID so a build
# fails early if EXPO_PUBLIC_FIREBASE_PROJECT_ID points somewhere else.
EXPO_PUBLIC_EXPECTED_FIREBASE_PROJECT_ID=your-project-id

# Required by the cleanup/rollback scripts and useful for Firebase CLI commands.
FIREBASE_PROJECT_ID=your-project-id

# Set to true ONLY after scripts/backfill-post-user-id.js has stamped `userId`
# onto every legacy post. It collapses the three-alias author lookup down to a
# single indexed query (~66% fewer Firestore reads on profile grids and the
# Following feed) and restores correct newest-first ordering. Leaving it unset
# keeps the safe legacy behaviour; unsetting it is an instant rollback.
EXPO_PUBLIC_POSTS_USERID_BACKFILLED=false

# Optional for EAS builds. Do not commit the native service files themselves.
EAS_PROJECT_ID=your-eas-project-id
IOS_GOOGLE_SERVICES_FILE=./GoogleService-Info.plist
ANDROID_GOOGLE_SERVICES_FILE=./google-services.json
EXPO_PUBLIC_VIDEO_RENDERER_URL=
