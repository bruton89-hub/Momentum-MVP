rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Modern posts use userId. Older production posts may use one of these
    // aliases, so deletion follows the same strict precedence as client reads
    // and the server callable. A conflicting lower-priority alias can never
    // override an existing canonical owner.
    function postOwnerId(data) {
      let userId = data.get('userId', '');
      let authorId = data.get('authorId', '');
      let uid = data.get('uid', '');
      let ownerId = data.get('ownerId', '');
      return userId is string && userId.size() > 0 ? userId
        : authorId is string && authorId.size() > 0 ? authorId
        : uid is string && uid.size() > 0 ? uid
        : ownerId is string && ownerId.size() > 0 ? ownerId
        : '';
    }
    // Keys that change between the existing doc and the incoming write.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // Client clocks are written as createdAt (deliberate: serverTimestamp()
    // resolves to null in the local cache and breaks newest-first ordering of
    // just-created docs). Bound the skew so a forged timestamp cannot pin a
    // document to the top of createdAt-ordered feeds indefinitely: at most
    // 15 minutes ahead of the server clock, at most 48 hours behind it.
    function isPlausibleClientTime(value) {
      return value is timestamp
        && value < request.time + duration.value(15, 'm')
        && value > request.time - duration.value(48, 'h');
    }
    // SERVER-ONLY status/credibility fields. wins/losses/posts are written by
    // finalizeBattle/deletePost (Admin SDK); the rest are reserved for future
    // server-side verification workflows. No client may ever write any of
    // them — a self-granted "verified" badge is identity forgery in a youth
    // sports app.
    function touchesProtectedUserFields(keys) {
      return keys.hasAny([
        'wins', 'losses', 'posts',
        'verified', 'isVerified', 'coachVerified',
        'tournamentChampion', 'topRanked', 'momentumScore'
      ]);
    }
    // The search index must mirror the display value it indexes. Without this
    // a modified client can register username "VictimName" while writing an
    // unrelated usernameLower, evading the client-side duplicate-handle check
    // (isUsernameTaken queries usernameLower only).
    function usernameSearchFieldConsistent(data) {
      return data.get('usernameLower', data.get('username', '').lower())
        == data.get('username', '').lower();
    }
    // Denormalized author identity on user-generated docs must be the writer's
    // real identity. '' is tolerated because a legitimate client can act in
    // the moments before its decorative profile store hydrates.
    function matchesAuthorUsername(value) {
      return value is string
        && (value == ''
          || !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || value == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', value));
    }
    // The athlete's current profile handle, or '' when they have no profile
    // document yet. Used to accept a battle entry whose display name reflects
    // a rename that happened after the backing post was written.
    function currentProfileUsername(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.get('username', '')
        : '';
    }
    // Media on user-generated docs must live under the writer's own Storage
    // prefix (posts/{uid}/...), as a plain path or URL-encoded download URL.
    // Blocks publishing another athlete's video as your own.
    function isOwnMediaPath(value, uid) {
      return value is string
        && (value.matches('.*posts%2F' + uid + '%2F.*')
          || value.matches('.*posts/' + uid + '/.*'));
    }

    // ─── Users ─────────────────────────────────────────────────────────────────
    // wins / losses are SERVER-ONLY: they are written exclusively by the
    // `finalizeBattle` Cloud Function (Admin SDK), which bypasses these rules.
    // No client may ever modify another user's doc, and no client (not even the
    // owner) may touch wins / losses / posts directly.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && request.resource.data.wins == 0
        && request.resource.data.losses == 0
        && request.resource.data.posts == 0
        // Credibility/status badges are server-granted only. A brand-new
        // profile may not arrive pre-verified.
        && !request.resource.data.keys().hasAny([
          'verified', 'isVerified', 'coachVerified',
          'tournamentChampion', 'topRanked', 'momentumScore'
        ])
        && usernameSearchFieldConsistent(request.resource.data);
      allow update: if isOwner(userId)
        && !touchesProtectedUserFields(changedKeys())
        && usernameSearchFieldConsistent(request.resource.data);
      // No client deletes.
    }

    // ─── Posts ─────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if isSignedIn();

      // Every field the current client's createPost writes, and nothing else.
      // Server-derived presentation fields (verified, momentumScore, battleWon,
      // isLive, pinned, commentsCount, …) are excluded by omission: normalizePost
      // reads them, so letting a client forge them at create time manufactured
      // credibility and feed-ranking manipulation.
      function hasValidNewPostShape() {
        return request.resource.data.keys().hasOnly([
            'userId', 'authorId', 'uid',
            'username',
            'userAvatar', 'avatarUrl', 'authorAvatar',
            'mediaUrl', 'mediaType', 'originalMediaUrl', 'videoEdit',
            'caption', 'battleEnabled', 'likesCount',
            'sport', 'position', 'school', 'teamName',
            'createdAt', 'updatedAt'
          ])
          // All author aliases must be the authenticated writer.
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.get('authorId', request.auth.uid) == request.auth.uid
          && request.resource.data.get('uid', request.auth.uid) == request.auth.uid
          // Engagement counters start at their neutral value.
          && request.resource.data.likesCount == 0
          && request.resource.data.mediaType in ['image', 'video']
          && request.resource.data.battleEnabled is bool
          && request.resource.data.caption is string
          && request.resource.data.caption.size() <= 2200
          // A post's media must live under the author's own Storage prefix.
          && isOwnMediaPath(request.resource.data.mediaUrl, request.auth.uid)
          && (!request.resource.data.keys().hasAny(['originalMediaUrl'])
            || isOwnMediaPath(request.resource.data.originalMediaUrl, request.auth.uid))
          // Client timestamps are bounded, not trusted (see isPlausibleClientTime).
          && isPlausibleClientTime(request.resource.data.createdAt)
          && isPlausibleClientTime(request.resource.data.updatedAt)
          // Displayed author name must be the writer's real handle (or '' while
          // the profile store hydrates).
          && matchesAuthorUsername(request.resource.data.username);
      }

      allow create: if isSignedIn() && hasValidNewPostShape();
      allow update: if isOwner(resource.data.userId)
        && changedKeys().hasOnly(['caption', 'battleEnabled', 'updatedAt'])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.likesCount == resource.data.likesCount;
      allow delete: if isOwner(postOwnerId(resource.data));
    }

    // ─── Likes ─────────────────────────────────────────────────────────────────
    match /likes/{likeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // ─── Saves (bookmarks) ─────────────────────────────────────────────────────
    // Doc ID convention: saves/{postId}_{userId} — compound key makes a save
    // idempotent and lets these rules verify ownership from the ID itself.
    //
    // PRIVATE: unlike likes, a save is only ever readable by the athlete who
    // made it. Nobody can enumerate another user's bookmarks. The owner writes
    // and deletes their own; no counters exist, so no server involvement.
    match /saves/{saveId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && saveId == request.resource.data.postId + '_' + request.auth.uid;
      // Immutable — a save is toggled by delete + create, never edited.
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ─── Battles ───────────────────────────────────────────────────────────────
    // status="completed", status="expired", winner, and statsRecorded are
    // SERVER-ONLY. They are written only by the `finalizeBattle` Cloud Function
    // (Admin SDK). "expired" means the challenge window closed with no opponent
    // — it is not a contest, records no stats, and is hidden from every list.
    // Clients may ONLY:
    //   1. Create a battle they own.
    //   2. Accept an open challenge (set playerB and flip status open → live).
      // Vote counters are written only by the castBattleVote callable.
    match /battles/{battleId} {
      allow read: if isSignedIn();

      // Battle creation is client-initiated, so every server-authoritative field
      // must start from its neutral value. Without this shape check, any signed-
      // in client could create an already-ended battle with forged vote totals;
      // finalizeBattle would then trust it and record arbitrary wins/losses.
      function hasValidNewBattleShape() {
        return request.resource.data.keys().hasOnly([
            'creatorId', 'playerA', 'playerB', 'votesA', 'votesB', 'status',
            'category', 'durationHours', 'endTime', 'winner',
            'statsRecorded', 'createdAt'
          ])
          && request.resource.data.creatorId == request.auth.uid
          && request.resource.data.playerA is map
          && request.resource.data.playerA.userId is string
          && request.resource.data.playerA.userId.size() > 0
          && request.resource.data.votesA == 0
          && request.resource.data.votesB == 0
          && request.resource.data.winner == null
          && request.resource.data.statsRecorded == false
          && request.resource.data.category in [
            'Highlights', 'Drills', 'Game Clips', 'Training', 'Free Style'
          ]
          && request.resource.data.durationHours in [24, 48, 168]
          && request.resource.data.endTime is timestamp
          && request.resource.data.endTime > request.time
          && isPlausibleClientTime(request.resource.data.createdAt);
      }

      // A battle entry must be backed by a real post that belongs to the
      // athlete it claims to represent, and must display that post's actual
      // media. Without this, any signed-in client could enter a battle with
      // another athlete's video as its own (content theft that converts a
      // victim's highlight into the attacker's votes), or pit a victim
      // against fabricated media they never posted.
      function playerEntryBackedByOwnPost(player) {
        let post = get(/databases/$(database)/documents/posts/$(player.postId)).data;
        return player.postId is string
          && player.postId.size() > 0
          && postOwnerId(post) == player.userId
          // Media must be the media actually on the backing post. The alias
          // fields are required, not optional: normalizePost resolves
          // mediaUrl || mediaURL || photoURL, so a legacy document surfaces a
          // URL to the client that is NOT in the canonical `mediaUrl` field.
          // Checking only the canonical field made every such legacy post
          // permanently un-battleable.
          && (player.mediaUrl == post.get('mediaUrl', '')
            || player.mediaUrl == post.get('mediaURL', '')
            || player.mediaUrl == post.get('photoURL', '')
            || player.mediaUrl == post.get('originalMediaUrl', ''))
          // The displayed name must be a name this athlete legitimately holds:
          // either the one stored on the backing post, or their CURRENT profile
          // handle. Both are required. Requiring only the post's name broke
          // every athlete who renamed themselves after posting — their client
          // builds the entry from the current profile, so an old post could
          // never be battled again. Requiring only the current profile would
          // symmetrically break challenging an athlete who has since renamed,
          // because that entry is copied from their older post.
          //
          // Scope of this check: it stops an arbitrary typed-in name. It is NOT
          // the primary anti-impersonation control — that is the userId↔post
          // ownership binding above, which is what actually prevents content
          // theft and false stat attribution. An attacker can still set their
          // own profile handle to any unclaimed value; handle uniqueness is a
          // separate, still-open issue (username reservation).
          && (player.username == post.get('username', player.username)
            || player.username == currentProfileUsername(player.userId));
      }

      function isValidOpenChallengeCreate() {
        return request.resource.data.status == 'open'
          && request.resource.data.playerB == null
          && request.resource.data.playerA.userId == request.auth.uid
          && playerEntryBackedByOwnPost(request.resource.data.playerA);
      }

      // Direct challenge: the creator is playerB (challenger) and playerA is
      // the challenged athlete — so BOTH entries are provenance-checked
      // against their backing posts. The creator legitimately writes another
      // athlete's identity into playerA, but only as copied from that
      // athlete's real post.
      function isValidLiveChallengeCreate() {
        return request.resource.data.status == 'live'
          && request.resource.data.playerB is map
          && request.resource.data.playerB.userId == request.auth.uid
          && request.resource.data.playerA.userId != request.auth.uid
          && playerEntryBackedByOwnPost(request.resource.data.playerA)
          && playerEntryBackedByOwnPost(request.resource.data.playerB);
      }

      allow create: if isSignedIn()
        && hasValidNewBattleShape()
        && (isValidOpenChallengeCreate() || isValidLiveChallengeCreate());

      // Accept an open challenge: only playerB + status may change, and the
      // battle must move from "open" to "live". Cannot set winner/statsRecorded.
      // The accepter must set THEMSELVES as playerB, and the original creator
      // may never accept their own challenge (no self-battles / double accepts).
      function isAcceptingChallenge() {
        return resource.data.status == 'open'
          && request.resource.data.status == 'live'
          && changedKeys().hasOnly(['playerB', 'status'])
          && request.resource.data.playerB.userId == request.auth.uid
          && resource.data.creatorId != request.auth.uid
          // The accepter's entry must be backed by their own real post — same
          // provenance check as creation, so an accept cannot smuggle in
          // stolen media or a forged identity either.
          && playerEntryBackedByOwnPost(request.resource.data.playerB);
      }

      // A retry after the server committed but the acknowledgement was lost
      // replays the exact same payload at the same deterministic document ID.
      // Permit only that byte-for-byte logical no-op; no field may change.
      function isIdempotentCreateReplay() {
        return resource.data.creatorId == request.auth.uid
          && request.resource.data == resource.data;
      }

      allow update: if isSignedIn()
        && (isAcceptingChallenge() || isIdempotentCreateReplay());

      // No client deletes; no client may set winner/statsRecorded/completed.
    }

    // ─── Votes ─────────────────────────────────────────────────────────────────
    // A vote may only be created by the authenticated user acting as themselves.
    // The doc ID convention ({battleId}_{uid}) guarantees one vote per user per
    // battle. Votes are immutable (no update / delete).
    match /votes/{voteId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // ─── Notifications ─────────────────────────────────────────────────────────
    // Deterministic doc IDs (per action) prevent duplicates: a second write to
    // an existing id is an UPDATE, which only the recipient may perform and
    // only to flip `read` — so repeat actions cannot re-create or spam.
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.recipientId == request.auth.uid;

      function hasValidNotificationBase() {
        return request.resource.data.keys().hasOnly([
            'type', 'recipientId', 'actorId', 'subjectUsername',
            'subjectAvatar', 'preview', 'postId', 'commentId', 'battleId', 'read',
            'createdAt'
          ])
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.recipientId is string
          && request.resource.data.recipientId != request.auth.uid
          && request.resource.data.subjectUsername is string
          && request.resource.data.subjectAvatar is string
          && request.resource.data.read == false
          && request.resource.data.createdAt is timestamp;
      }

      function isValidFollowNotification() {
        let followId = request.auth.uid + '_' + request.resource.data.recipientId;
        let follow = get(/databases/$(database)/documents/follows/$(followId)).data;
        let actor = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return request.resource.data.type == 'follow'
          && notificationId == 'follow_' + followId
          && follow.followerId == request.auth.uid
          && follow.followingId == request.resource.data.recipientId
          && request.resource.data.subjectUsername == actor.username;
      }

      function isValidCommentNotification() {
        let comment = get(/databases/$(database)/documents/comments/$(request.resource.data.commentId)).data;
        let post = get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data;
        return request.resource.data.type == 'comment'
          && notificationId == 'comment_' + request.resource.data.commentId
          && comment.userId == request.auth.uid
          && comment.postId == request.resource.data.postId
          && post.userId == request.resource.data.recipientId
          && request.resource.data.subjectUsername == comment.username;
      }

      function isValidChallengeReceivedNotification() {
        let battle = get(/databases/$(database)/documents/battles/$(request.resource.data.battleId)).data;
        return request.resource.data.type == 'challenge_received'
          && notificationId == 'challenge_' + request.resource.data.battleId
          && battle.status == 'live'
          && battle.creatorId == request.auth.uid
          && battle.playerB.userId == request.auth.uid
          && battle.playerA.userId == request.resource.data.recipientId
          && request.resource.data.subjectUsername == battle.playerB.username;
      }

      function isValidChallengeAcceptedNotification() {
        let battle = get(/databases/$(database)/documents/battles/$(request.resource.data.battleId)).data;
        return request.resource.data.type == 'challenge_accepted'
          && notificationId == 'accepted_' + request.resource.data.battleId
          && battle.status == 'live'
          && battle.playerB.userId == request.auth.uid
          && battle.playerA.userId == request.resource.data.recipientId
          && battle.creatorId == request.resource.data.recipientId
          && request.resource.data.subjectUsername == battle.playerB.username;
      }

      allow create: if isSignedIn()
        && hasValidNotificationBase()
        && (isValidFollowNotification()
          || isValidCommentNotification()
          || isValidChallengeReceivedNotification()
          || isValidChallengeAcceptedNotification());
      // Recipient may mark read (one-way).
      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && changedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      // No deletes in v1.
    }

    // ─── Comments ──────────────────────────────────────────────────────────────
    // Flat, post-scoped comments (no replies, no edits).
    // Fields: postId, userId, username, avatar, text, createdAt
    match /comments/{commentId} {
      allow read: if isSignedIn();
      // Author-owned create with shape validation. The displayed commenter
      // identity must be the writer's real handle — comment notifications
      // trust comment.username, so a forged name here propagated into the
      // recipient's notification feed as a verified-looking impersonation.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'postId', 'userId', 'username', 'avatar', 'text', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && isPlausibleClientTime(request.resource.data.createdAt)
        && matchesAuthorUsername(request.resource.data.username);
      // Authors may delete their own comments. Comments are immutable.
      allow delete: if isOwner(resource.data.userId);
    }

    // ─── Follows ───────────────────────────────────────────────────────────────
    // Doc ID convention: {followerId}_{followingId}
    // Fields: followerId, followingId, createdAt
    match /follows/{followId} {
      // Any signed-in user can read follows (public social graph)
      allow read: if isSignedIn();
      // A user can only create a follow doc where they are the follower,
      // and the doc ID must match the {followerId}_{followingId} pattern.
      // The target must be a real other user: self-follows and empty targets
      // were previously accepted (only client code guarded them).
      allow create: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId.size() > 0
        && request.resource.data.followingId != request.auth.uid
        && followId == (request.auth.uid + '_' + request.resource.data.followingId);
      // A user can only delete their own follow docs
      allow delete: if isSignedIn()
        && resource.data.followerId == request.auth.uid;
    }
  }
}
