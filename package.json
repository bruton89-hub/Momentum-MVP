{
  "name": "momentum-mvp",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "npx expo start",
    "start:clear": "npx expo start --clear",
    "ios": "npx expo run:ios",
    "android": "npx expo run:android",
    "web": "npx expo start --web",
    "typecheck": "tsc --noEmit",
    "test:rules": "node scripts/run-firestore-rules-tests.js",
    "test:functions:emulator": "npm --prefix functions run build && CI=1 XDG_CONFIG_HOME=$PWD/.firebase-config XDG_CACHE_HOME=$PWD/.firebase-cache FIREBASE_EMULATORS_PATH=$PWD/.firebase-data firebase emulators:exec --project demo-momentum-phase0 --only functions \"FUNCTIONS_EMULATOR=true npm --prefix functions run test:contracts\"",
    "verify": "npm run typecheck && npm run test:battles && npm --prefix functions run build && npm run test:rules && npm run test:functions:emulator",
    "test:battles": "node --test test/battleSections.test.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.21.0",
    "@types/react": "~18.2.45",
    "expo": "~50.0.6",
    "expo-av": "~13.10.6",
    "expo-constants": "~15.4.5",
    "expo-image-picker": "~14.7.1",
    "expo-linear-gradient": "~12.7.2",
    "expo-linking": "~6.2.2",
    "expo-router": "~3.4.10",
    "expo-splash-screen": "~0.26.5",
    "expo-status-bar": "~1.11.1",
    "expo-video-thumbnails": "~7.9.0",
    "firebase": "^10.14.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-reanimated": "~3.6.2",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-web": "~0.19.6",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.3",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.13.0",
    "typescript": "^5.3.0"
  }
}
